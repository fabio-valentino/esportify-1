# Alamat API Laravel (tanpa slash di akhir)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK=false
VITE_USE_ADMIN_MOCK=false

VITE_SKIP_AUTH=false

# true = Kelola Game memakai mock (sementara, sampai semua endpoint game selesai)
VITE_USE_GAME_MOCK=false
VITE_USE_TOURNAMENT_MOCK=true

# Batas pengajuan dianggap prioritas (menit). 4320 = 3 hari. Untuk uji backend isi 3.
VITE_PRIORITY_MINUTES=4320