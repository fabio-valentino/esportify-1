# Alamat API Laravel (tanpa slash di akhir)
VITE_API_BASE_URL=http://localhost:8000/api

# false = pakai API asli. Ubah ke true HANYA sementara kalau backend belum siap.
VITE_USE_MOCK=false

# true = data panel admin dari mock (sementara). Default false.
VITE_USE_ADMIN_MOCK=false

# Hanya untuk development: true = lewati pengecekan login di frontend.
# Wajib false untuk pengujian sebenarnya.
VITE_SKIP_AUTH=false